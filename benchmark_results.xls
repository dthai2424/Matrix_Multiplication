 <Worksheet ss:Name="Thong_So_CPU_CUDA">
  <Table ss:DefaultRowHeight="20">
   <Column ss:Width="220"/>
   <Column ss:Width="350"/>
   <Row ss:Height="26">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Thông số hệ thống & phần cứng</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Giá trị chi tiết</Data></Cell>
   </Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Hệ điều hành (OS)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">Windows 10 Home Single Language (64-bit)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Trình biên dịch</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">NVCC 13.5 / MSVC 1944 (OpenMP 2019)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Bộ nhớ hệ thống (RAM)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">15.25 GB (Khả dụng: 6.31 GB)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Bộ vi xử lý (CPU)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">AMD Ryzen 7 6800H with Radeon Graphics</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Số nhân vật lý (Physical Cores)</Data></Cell><Cell ss:StyleID="DataInteger"><Data ss:Type="Number">8</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Số luồng logic (Logical Processors)</Data></Cell><Cell ss:StyleID="DataInteger"><Data ss:Type="Number">16</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">L1 Data Cache (mỗi nhân)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">32 KB (Khối Tile1 khuyến nghị: 32 - 64)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">L2 Cache (mỗi nhân)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">512 KB (Khối Tile2 khuyến nghị: 64 - 128)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">L3 Cache (chia sẻ dùng chung)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">16 MB (Khối Tile3 khuyến nghị: 256 - 512)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Thiết bị CUDA (GPU)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">NVIDIA GeForce RTX 3050 Ti Laptop GPU</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Dung lượng VRAM GPU</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">4095 MB (4.00 GB)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Compute capability</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">8.6</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Số Multiprocessors (SMs)</Data></Cell><Cell ss:StyleID="DataInteger"><Data ss:Type="Number">20</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Tổng số nhân CUDA (CUDA Cores)</Data></Cell><Cell ss:StyleID="DataInteger"><Data ss:Type="Number">2560</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Phiên bản CUDA</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">Runtime 13.3 (Driver 13.3)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Mô hình bộ nhớ</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">SMP Shared Memory (Fork-Join OpenMP)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Tập lệnh vector hóa</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">AVX2 + FMA3 (256-bit SIMD registers)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Định luật Amdahl (Mục 3.5)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">Speedup = 1 / ( (1 - p) + p / q )</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Tài liệu đối chiếu</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">An - CPU song song hóa.docx (Kelefouras et al., 2016)</Data></Cell></Row>
  </Table>
 </Worksheet>
</Workbook>
